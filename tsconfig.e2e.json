{
  "include": [
    "src/main/db.ts",
    "src/main/search.ts",
    "src/main/indexer.ts",
    "src/main/watcher.ts",
    "src/main/media.ts",
    "src/main/scan.ts",
    "src/main/datadir.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out-e2e",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}
