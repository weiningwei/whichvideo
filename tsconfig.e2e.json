{
  // 不要改回手写文件列表：新增 src/main/xxx.ts 会被静默漏掉，
  // 而且是"自检跑不到它"这种只在覆盖面上暴露的问题（和 electron.vite.config.ts 的入口同理）。
  "include": ["src/main/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out-e2e",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}
