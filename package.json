{
  "name": "whichvideo",
  "version": "0.1.0",
  "description": "本地视频库：导入视频/文件夹，以图搜帧，查看图片对应视频是否已下载，文件夹动态更新",
  "main": "./out/main/index.js",
  "author": "weiningwei",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "tauri": "tauri",
    "dev:tauri": "vite --port 1420 --strictPort --host",
    "build:renderer": "vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "icon": "node scripts/generate-icon.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build && npm run icon",
    "build:win": "npm run build && electron-builder --win",
    "build:portable": "npm run build && node scripts/build-portable-folder.mjs",
    "build:tauri-portable": "pnpm tauri build --no-bundle && node scripts/build-tauri-portable.mjs",
    "build:unpack": "npm run build && electron-builder --win dir",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "test:core": "node scripts/build-core.mjs && node scripts/e2e.mjs",
    "test:portable": "node scripts/build-core.mjs && node scripts/test-datadir.mjs",
    "test:clipboard": "node scripts/build-core.mjs && node scripts/test-clipboard.mjs",
    "test:pack": "node scripts/test-portable-builder.mjs",
    "test:tauri-portable": "node scripts/test-tauri-portable.mjs",
    "test:rust": "node scripts/test-rust.mjs",
    "test:tauri-contract": "node scripts/test-tauri-contract.mjs",
    "test:asar": "node scripts/test-asar-check.mjs",
    "bench:frames": "node scripts/build-core.mjs && node scripts/bench-frames.mjs",
    "bench:hash": "node scripts/build-core.mjs && node scripts/bench-hash-detail.mjs",
    "test:config": "node scripts/test-build-config.mjs",
    "test:frames": "node scripts/build-core.mjs && node scripts/test-frame-policy.mjs",
    "test:hash": "node scripts/build-core.mjs && node scripts/test-hash-coverage.mjs",
    "test:path": "node scripts/test-path-format.mjs",
    "test:url": "node scripts/build-core.mjs && node scripts/test-url-image.mjs",
    "test:icon": "node scripts/test-icon.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:network": "node scripts/test-network.mjs",
    "test:cursor": "node scripts/test-cursor.mjs",
    "test:range": "node scripts/test-range-select.mjs",
    "test:scale": "node scripts/build-core.mjs && node scripts/test-hash-scale.mjs",
    "test:output": "node scripts/build-core.mjs && node scripts/test-build-output.mjs",
    "test:startup": "node scripts/build-core.mjs && node scripts/startup-smoke.mjs",
    "test:sampling": "node scripts/build-core.mjs && node scripts/test-sampling.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test": "npm run typecheck && npm run test:rust && npm run test:tauri-contract && npm run test:tauri-portable && npm run test:theme && npm run test:cursor && npm run test:range && npm run test:path && npm run test:ui && npm run test:events",
    "rebuild:native": "electron-builder install-app-deps",
    "test:events": "node scripts/test-video-events.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
