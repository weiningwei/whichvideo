{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhichVideo",
  "version": "0.1.0",
  "identifier": "com.weiningwei.whichvideo",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhichVideo · 以图搜视频",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: file: ipc: http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../resources/bin/ffmpeg.exe": "resources/bin/ffmpeg.exe",
      "../resources/bin/ffprobe.exe": "resources/bin/ffprobe.exe"
    }
  }
}
