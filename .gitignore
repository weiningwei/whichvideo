# ---- Node / Electron ----
node_modules/
.pnpm-store/
# pnpm 11 会在安装时自动生成这个文件（构建脚本白名单），内容与机器相关，不入库
pnpm-workspace.yaml
out/
out-e2e/
dist/
release/
*.tsbuildinfo
.vite/
.electron-cache/

# ---- 运行时数据（索引库、日志、测试素材）----
data/
tmp/
*.db
*.db-wal
*.db-shm

# ---- ffmpeg 本地二进制（体积大，不进版本库；用 pnpm fetch:ffmpeg 下载）----
# 保留占位文件，保证 extraResources 的源目录存在
resources/bin/*
!resources/bin/.gitkeep

# ---- Python（仓库保留了 Python 版忽略规则）----
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
# Python 打包产物的目录一律锚定到仓库根目录，
# 否则 lib/ 这种规则会连 scripts/lib/ 一起忽略掉
/build/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.venv/
venv/
ENV/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
